+		const Comp = function () {};
+		Comp.prototype = {};
+		return { default: Comp };
+	}
+}));
+
+vi.mock('$app/state', () => ({
+	page: { url: new URL('http://localhost/profile') }
+}));
+vi.mock('$lib/stores/authStore.svelte', () => ({
+	authStore: { user: { id: 'u1', providers: ['oidc'] } }
+}));
+vi.mock('$lib/queries/profile/ProfileQuery.svelte', () => ({
+	getProfileQuery: () => ({
+		data: { id: 'u1', providers: ['oidc'] },
+		isPending: false,
+		isError: false,
+		refetch: vi.fn()
