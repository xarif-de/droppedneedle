{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>infra/renovate-config"],
    // Fork of DroppedNeedle/DroppedNeedle, line v3 (XARIF.md): Renovate maintains ONLY our
    // infra files (the suite images in dagger-ci.yaml). Upstream files follow upstream
    // through fork-sync; a Renovate PR on them would be rejected by fork-check (non-sync
    // PRs may only change infra paths).
    "enabledManagers": ["custom.regex"],
    "ignorePaths": [".github/**", "server/**", "frontend/**", "sdk/**", "examples/**", "docs/**", "templates/**", "Images/**", "Dockerfile", "docker-compose.example.yml", "Makefile", "rust-toolchain.toml", "entrypoint.sh"]
}
